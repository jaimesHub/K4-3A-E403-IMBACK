# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; OpenRouter recommended) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Helpdesk tools use deterministic local mock data and need no additional keys.

# --- Optional external device search (Tavily) ---
TAVILY_API_KEY=

# --- vlearn (D2 "Học từ lỗi trước" — quiz backend) ---
# Ép chạy offline (mock, không cần key/mạng) khi = 1. Rỗng = tự dò theo key có sẵn ở trên.
VLEARN_OFFLINE=
# Ép chọn provider cụ thể (openai|openrouter|anthropic|gemini). Rỗng = tự dò theo thứ tự
# openrouter -> openai -> anthropic -> gemini, provider nào có key trước thì dùng.
VLEARN_PROVIDER=
# Ép chọn model cụ thể cho provider đã chọn. Rỗng = dùng model mặc định của provider đó.
VLEARN_MODEL=
# Cổng chạy `python api.py` / `python vlearn_cli.py serve`. Rỗng = 8000.
VLEARN_PORT=
# Đường dẫn tới transcript-04-clean.md thật (KHÔNG có trong repo) để chạy run_quiz_eval.py.
VLEARN_EVAL_TRANSCRIPT=
